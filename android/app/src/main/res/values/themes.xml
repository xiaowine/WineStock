<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 应用主题：承载 WebView 内容区域的常规外观。UI 全部在 WebView 内；
         Window/Splash 的首帧背景按系统 day/night 资源跟随，前端加载后再应用本机手动偏好。 -->
    <style name="Base.Theme.WineStock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme" tools:targetApi="29">@bool/app_is_light_theme</item>
        <item name="android:windowBackground">@color/web_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
    </style>

    <style name="Theme.WineStock" parent="Base.Theme.WineStock" />

    <!-- 冷启动 SplashScreen 主题：接管系统启动窗口，中性底 + 居中 logo。
         由 core-splashscreen 提供跨版本一致行为，Activity 通过 installSplashScreen() 接管并延迟隐藏；
         就绪后回到 postSplashScreenTheme 指向的常规主题。 -->
    <style name="Theme.WineStock.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/web_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.WineStock</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/window_light_system_bars</item>
    </style>
</resources>
