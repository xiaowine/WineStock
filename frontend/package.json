{
  "name": "winestock-frontend",
  "private": true,
  "version": "0.0.0",
  "appStage": "Beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:android": "vue-tsc -b && vite build --mode android",
    "desktop:dev": "cd /d ..\\desktop && ..\\frontend\\node_modules\\.bin\\tauri.cmd dev",
    "desktop:build": "cd /d ..\\desktop && ..\\frontend\\node_modules\\.bin\\tauri.cmd build",
    "preview": "vite preview",
    "test:lan-access": "node --test tests/lanAccess.test.mjs",
    "test:native-back": "node --test tests/nativeBackCore.test.mjs",
    "test:shell-bridge-contract": "node --test tests/shellBridgeContract.test.mjs",
    "test:runtime-funnel": "node --test tests/runtimeFunnel.test.mjs",
    "test:item-lcsc": "node --test tests/itemLcscMapping.test.mjs",
    "test:lcsc-image": "node --test tests/lcscImage.test.mjs",
    "test:lcsc-bag": "node --test tests/lcscBagCode.test.mjs",
    "test:lcsc-order": "node --test tests/lcscOrderExport.test.mjs",
    "test:erp-backup": "node --test tests/erpBackupImport.test.mjs",
    "test:availability-policy": "node --test tests/serviceAvailabilityPolicy.test.mjs",
    "test:clipboard": "node --test tests/clipboardModel.test.mjs",
    "test:theme": "node --test tests/themeModel.test.mjs",
    "gen:api-types": "openapi-typescript ../target/openapi/openapi.json -o src/api/generated/schema.d.ts",
    "gen:api": "cargo run -p winestock-core --example dump_openapi && pnpm gen:api-types",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zxing-wasm": "^3.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "sass-embedded": "1.100.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-compression2": "^2.5.3",
    "vue-tsc": "^3.3.9"
  }
}
