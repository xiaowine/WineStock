{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WineStock",
  "version": "0.1.0",
  "identifier": "cc.xiaowine.winestock",
  "build": {
    "beforeDevCommand": "pnpm --dir D:/Project/WineStock/frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir D:/Project/WineStock/frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https://alimg.szlcsc.com; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "minimumWebview2Version": "111.0.0.0",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "SimpChinese": "nsis/languages/SimpChinese.nsh"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
